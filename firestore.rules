rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function userData(userId) {
      return get(userPath(userId)).data;
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function createdAtIsServerTime(data) {
      return !hasField(data, "createdAt") || data.createdAt == request.time;
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 20
        && username.matches("^[A-Za-z0-9_]+$");
    }

    function validNormalizedUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 20
        && username.matches("^[a-z0-9_]+$");
    }

    function validUsernameReservation(userId, username) {
      return validNormalizedUsername(username)
        && existsAfter(usernamePath(username))
        && getAfter(usernamePath(username)).data.userId == userId;
    }

    function notSuspended(userId) {
      return exists(userPath(userId))
        && (
          !hasField(userData(userId), "suspensionStatus")
          || (
            userData(userId).suspensionStatus != "banned"
            && (
              userData(userId).suspensionStatus != "suspended"
              || (
                hasField(userData(userId), "suspensionExpiresAt")
                && userData(userId).suspensionExpiresAt <= request.time
              )
            )
          )
        );
    }

    function safeUserCreate(userId) {
      return owns(userId)
        && request.resource.data.keys().hasAll(["username", "email", "usernameLowercase"])
        && request.resource.data.keys().hasOnly([
          "username",
          "email",
          "usernameLowercase",
          "profileImageUrl",
          "createdAt",
          "blockedUsers",
          "isPrivateProfile",
          "notifyNearbyPings",
          "notifyHotPings",
          "fcmToken",
          "lastKnownLocation",
          "hasCompletedOnboarding",
        ])
        && validUsername(request.resource.data.username)
        && validNormalizedUsername(request.resource.data.usernameLowercase)
        && request.resource.data.email is string
        && validUsernameReservation(userId, request.resource.data.usernameLowercase)
        && !request.resource.data.keys().hasAny(["suspensionStatus", "suspensionExpiresAt"])
        && createdAtIsServerTime(request.resource.data);
    }

    function safeUserUpdate(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return owns(userId)
        && changedKeys.hasOnly([
          "username",
          "usernameLowercase",
          "profileImageUrl",
          "blockedUsers",
          "isPrivateProfile",
          "notifyNearbyPings",
          "notifyHotPings",
          "fcmToken",
          "lastKnownLocation",
          "hasCompletedOnboarding",
        ])
        && (
          !changedKeys.hasAny(["username", "usernameLowercase"])
          || (
            validUsername(request.resource.data.username)
            && validUsernameReservation(userId, request.resource.data.usernameLowercase)
            && (
              request.resource.data.usernameLowercase == resource.data.usernameLowercase
              || !existsAfter(usernamePath(resource.data.usernameLowercase))
            )
          )
        );
    }

    function safePingCreate(pingId) {
      return signedIn()
        && notSuspended(request.auth.uid)
        && request.auth.uid == request.resource.data.creatorId
        && request.resource.data.keys().hasAll([
          "creatorId",
          "text",
          "location",
          "geohash",
          "expiresAt",
          "status",
          "boostCount",
          "participantCount",
          "chatId",
        ])
        && request.resource.data.keys().hasOnly([
          "creatorId",
          "text",
          "category",
          "location",
          "geohash",
          "expiresAt",
          "status",
          "boostCount",
          "participantCount",
          "chatId",
          "createdAt",
          "imageUrl",
        ])
        && (!hasField(request.resource.data, "imageUrl") || request.resource.data.imageUrl is string)
        && (!hasField(request.resource.data, "category") || request.resource.data.category is string)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.location is latlng
        && request.resource.data.geohash is string
        && request.resource.data.status == "active"
        && request.resource.data.boostCount == 0
        && request.resource.data.participantCount == 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(49, "h")
        && request.resource.data.chatId is string
        && existsAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && getAfter(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.pingId == pingId
        && createdAtIsServerTime(request.resource.data);
    }

    function safeChatCreate(chatId) {
      return signedIn()
        && notSuspended(request.auth.uid)
        && request.resource.data.keys().hasAll(["pingId", "participantCount"])
        && request.resource.data.keys().hasOnly(["pingId", "participantCount", "lastMessageAt", "createdAt"])
        && request.resource.data.pingId is string
        && request.resource.data.participantCount == 0
        && existsAfter(/databases/$(database)/documents/pings/$(request.resource.data.pingId))
        && getAfter(/databases/$(database)/documents/pings/$(request.resource.data.pingId)).data.creatorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/pings/$(request.resource.data.pingId)).data.chatId == chatId
        && createdAtIsServerTime(request.resource.data);
    }

    function safeMessageCreate() {
      return signedIn()
        && notSuspended(request.auth.uid)
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.keys().hasAll(["chatId", "senderId", "text"])
        && request.resource.data.keys().hasOnly(["chatId", "senderId", "text", "createdAt", "isModerated", "messageType", "latitude", "longitude", "locationName"])
        && request.resource.data.chatId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && (!hasField(request.resource.data, "isModerated") || request.resource.data.isModerated == false)
        && (!hasField(request.resource.data, "messageType") || request.resource.data.messageType == "text" || request.resource.data.messageType == "location")
        && (
          !hasField(request.resource.data, "messageType")
          || request.resource.data.messageType != "location"
          || (request.resource.data.latitude is number && request.resource.data.longitude is number)
        )
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && exists(/databases/$(database)/documents/pings/$(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.pingId))
        && get(/databases/$(database)/documents/pings/$(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.pingId)).data.status == "active"
        && createdAtIsServerTime(request.resource.data);
    }

    function safeReactionUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && notSuspended(request.auth.uid)
        && changedKeys.hasOnly(["reactions"])
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.text == resource.data.text;
    }

    function safeBlockCreate() {
      return signedIn()
        && notSuspended(request.auth.uid)
        && request.resource.data.keys().hasAll(["blockerId", "blockedUserId"])
        && request.resource.data.keys().hasOnly(["blockerId", "blockedUserId", "createdAt"])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && createdAtIsServerTime(request.resource.data);
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if safeUserCreate(userId);
      allow update: if safeUserUpdate(userId);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["userId", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && validNormalizedUsername(username)
        && createdAtIsServerTime(request.resource.data);
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.usernameLowercase != username;
    }

    match /pings/{pingId} {
      allow read: if signedIn();
      allow create: if safePingCreate(pingId);
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn();
      allow create: if safeChatCreate(chatId);
      allow update, delete: if false;
    }

    match /chatMessages/{messageId} {
      allow read: if signedIn();
      allow create: if safeMessageCreate();
      allow update: if safeReactionUpdate();
      allow delete: if false;
    }

    match /chatParticipants/{participantId} {
      allow read, write: if false;
    }

    match /boosts/{boostId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn();
      allow create: if safeBlockCreate();
      allow delete: if signedIn() && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow get, list: if false;
      allow create: if false;
      allow update, delete: if false;
    }

    match /moderationActions/{actionId} {
      allow read, write: if false;
    }
  }
}
